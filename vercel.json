{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/adminpanel.html",
      "destination": "/admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/comics/:slug",
      "destination": "/item.html"
    },
    {
      "source": "/articles/:slug",
      "destination": "/item.html"
    },
    {
      "source": "/movies/:slug",
      "destination": "/item.html"
    },
    {
      "source": "/characters/:slug",
      "destination": "/item.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
