{
  "name": "deadverse-server",
  "version": "1.0.0",
  "private": true,
  "description": "DEADVERSE backend: Express API on Vercel with Neon PostgreSQL (content and images in one database)",
  "type": "module",
  "engines": {
    "node": ">=18.14"
  },
  "main": "api/index.js",
  "scripts": {
    "dev": "node server/dev.js",
    "start": "node server/dev.js",
    "db:setup": "node server/migrate.js",
    "build": "node scripts/build-site.js",
    "test": "node --test \"tests/*.test.js\"",
    "verify": "node server/verify.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "supertest": "7.0.0"
  }
}
