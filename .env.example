# ── Neon PostgreSQL ────────────────────────────────────────────────
# Neon console → your project → Dashboard → Connection string
# استفاده از pooled connection (سروری که در میزبان سرورلس) لازم است.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────
# حداقل ۳۲ کاراکتر تصادفی. برای تولید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters
JWT_EXPIRES_IN=12h

# ── ادمین اولیه (فقط برای npm run db:setup) ────────────────────────
# اگر ADMIN_PASSWORD را خالی بگذاری، یک رمز تصادفی ساخته و چاپ می‌شود.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# ── CORS ───────────────────────────────────────────────────────────
# آدرس‌هایی که اجازه دارند با API کار کنند، با کاما جدا شوند.
# اگر فقط روی Vercel هاست می‌کنی، این را خالی بگذار (هم‌ریشه هستید) —
# دامنه‌ی اختصاصی مثل deadverse.ir هم خودش /api را دارد، پس اینجا لازم نیست.
# برای GitHub Pages:
ALLOWED_ORIGINS=https://nitson-games.github.io,http://localhost:5500,http://127.0.0.1:3000

# ── آدرس API که فایل‌های HTML استفاده می‌کنند ──────────────────────
# فقط برای اسکریپت تست محلی لازم است.
API_BASE_URL=http://localhost:3000/api

# ───────────────────────────── ضد‌اسپم و خواننده‌ها (همه اختیاری) ───
# عمر توکن حساب خواننده (کسی که مقاله می‌خواند). توکن ادمین همیشه JWT_EXPIRES_IN است.
MEMBER_JWT_EXPIRES_IN=30d

# هر ایمیل چند دقیقه نمی‌تواند دوباره پیام بفرستد. ۰ یعنی بدون سقف.
CONTACT_COOLDOWN_MINUTES=30

# اگر این دو را با هم پر کنی، ویجت Cloudflare Turnstile جای سوال حسابی می‌نشیند
# و سوال روی صفحه اصلاً دیده نمی‌شود. خالی = همان سوال داخلی (بدون سرویس ثالث).
# https://dash.cloudflare.com → Turnstile → Site Key / Secret Key
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
